# ============================================
# K-Content YouTube Shorts Automation
# .env 설정 파일
# ============================================
# 이 파일을 .env로 복사한 뒤 실제 키를 입력하세요:
#   cp .env.example .env
#
# ⚠️ .env 파일은 절대 git에 커밋하지 마세요!
# ============================================

# ── OpenAI API ──
# TTS 오디션 후보 생성용
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Gemini API ──
# Gemini TTS (오디션 후보)용
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── YouTube OAuth ──
# Google Cloud Console에서 다운받은 OAuth 클라이언트 JSON 경로
YOUTUBE_CLIENT_SECRET=credentials/youtube_oauth.json

# ── TTS 설정 (OpenAI 오디션용) ──
TTS_MODEL=tts-1-hd

# ── 업로드 설정 ──
# private(비공개), unlisted(일부공개), public(공개)
UPLOAD_PRIVACY=private

# ── ElevenLabs (보이스 · 효과음 · BGM) ──
ELEVENLABS_API_KEY=

# ── BytePlus ModelArk (Seedance 영상 생성) ──
# 콘솔: https://ai.byteplus.com/ark/region:ap-southeast-1/apiKey
# 주의: Seedance 2.0/2.5 활성화에는 계정 잔액 USD 30 이상이 필요합니다.
MODELARK_API_KEY=
# 리전 base URL (기본: ap-southeast-1)
MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# 모델 ID — mini가 캐릭터 락 지원 + 최저가
MODELARK_VIDEO_MODEL=dreamina-seedance-2-0-mini-260615

# ── 일반 설정 ──
# 결과물 저장 경로
OUTPUT_DIR=output
